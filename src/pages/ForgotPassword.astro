---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Recuperar Contrasena - ESINSA WMS">
  <div id="auth-root"></div>
</BaseLayout>

<script>
  import React, { useState, FormEvent } from 'react';
  import { createRoot } from 'react-dom/client';
  import { auth, sendPasswordResetEmail } from '../lib/firebase';

  function ForgotPasswordForm() {
    const [email, setEmail] = useState('');
    const [error, setError] = useState('');
    const [success, setSuccess] = useState(false);
    const [loading, setLoading] = useState(false);

    const handleSubmit = async (e: FormEvent) => {
      e.preventDefault();
      setError('');
      setLoading(true);

      try {
        await sendPasswordResetEmail(auth, email);
        setSuccess(true);
      } catch (e: any) {
        const messages: Record<string, string> = {
          'auth/user-not-found': 'No existe una cuenta con este correo.',
          'auth/invalid-email': 'Correo electronico invalido.',
        };
        setError(messages[e.code] || 'Error al enviar el correo de recuperacion.');
      } finally {
        setLoading(false);
      }
    };

    if (success) {
      return React.createElement('div', { className: 'relative min-h-screen flex items-center justify-center bg-gray-100 dark:bg-gray-950' },
        React.createElement('div', { className: 'relative z-10 mx-auto max-w-lg px-4 py-16 w-full' },
          React.createElement('div', { className: 'text-center' },
            React.createElement('div', { className: 'mx-auto inline-flex size-14 items-center justify-center rounded-full bg-green-600 shadow-lg shadow-green-600/25' },
              React.createElement('svg', { className: 'size-7 text-white', fill: 'none', viewBox: '0 0 24 24', strokeWidth: '1.5', stroke: 'currentColor' },
                React.createElement('path', { strokeLinecap: 'round', strokeLinejoin: 'round', d: 'M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75' })
              )
            ),
            React.createElement('h1', { className: 'mt-4 text-2xl font-bold text-gray-900 dark:text-white' }, 'Correo Enviado'),
            React.createElement('p', { className: 'mt-2 text-sm text-gray-500 dark:text-gray-400' },
              'Revisa tu bandeja de entrada y sigue las instrucciones para recuperar tu contrasena.'
            ),
            React.createElement('a', { href: '/signin', className: 'mt-6 inline-block rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition' },
              'Volver al inicio de sesion'
            )
          )
        )
      );
    }

    return React.createElement('div', { className: 'relative min-h-screen flex items-center justify-center bg-gray-100 dark:bg-gray-950' },
      React.createElement('div', { className: 'fixed inset-0 z-0' },
        React.createElement('img', { src: 'https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?w=1920&q=80', alt: '', className: 'h-full w-full object-cover opacity-20 dark:opacity-10' }),
        React.createElement('div', { className: 'absolute inset-0 bg-gradient-to-b from-gray-100/80 via-gray-100/90 to-gray-100/80 dark:from-gray-950/80 dark:via-gray-950/90 dark:to-gray-950/80' })
      ),
      React.createElement('div', { className: 'relative z-10 mx-auto max-w-lg px-4 py-16 w-full' },
        React.createElement('div', { className: 'text-center' },
          React.createElement('div', { className: 'mx-auto inline-flex size-14 items-center justify-center rounded-full bg-indigo-600 shadow-lg shadow-indigo-600/25' },
            React.createElement('svg', { className: 'size-7 text-white', fill: 'none', viewBox: '0 0 24 24', strokeWidth: '1.5', stroke: 'currentColor' },
              React.createElement('path', { strokeLinecap: 'round', strokeLinejoin: 'round', d: 'M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z' })
            )
          ),
          React.createElement('h1', { className: 'mt-4 text-2xl font-bold text-gray-900 dark:text-white' }, 'Recuperar Contrasena'),
          React.createElement('p', { className: 'mt-1 text-sm text-gray-500 dark:text-gray-400' }, 'Ingresa tu correo y te enviaremos instrucciones')
        ),
        React.createElement('div', { className: 'mt-8 rounded-xl border border-gray-200 dark:border-gray-800 bg-white/90 dark:bg-gray-900/90 backdrop-blur-sm p-8 shadow-xl' },
          error && React.createElement('div', { className: 'mb-4 rounded-lg bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 p-3 text-sm text-red-700 dark:text-red-400' }, error),

          React.createElement('form', { onSubmit: handleSubmit, className: 'space-y-4' },
            React.createElement('div', null,
              React.createElement('label', { className: 'block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1' }, 'Email'),
              React.createElement('input', {
                type: 'email', required: true, value: email,
                onChange: (e: any) => setEmail(e.target.value),
                className: 'w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2.5 text-sm text-gray-900 dark:text-white placeholder-gray-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 focus:outline-none',
                placeholder: 'tu@email.com'
              })
            ),
            React.createElement('button', {
              type: 'submit', disabled: loading,
              className: 'w-full rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 disabled:opacity-50 disabled:cursor-not-allowed transition'
            }, loading ? 'Enviando...' : 'Enviar instrucciones')
          ),

          React.createElement('div', { className: 'relative my-6' },
            React.createElement('div', { className: 'absolute inset-0 flex items-center' },
              React.createElement('div', { className: 'w-full border-t border-gray-200 dark:border-gray-700' })
            )
          ),

          React.createElement('a', { href: '/signin', className: 'block w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-center text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-300 dark:hover:bg-gray-700 transition' }, 'Volver al inicio de sesion')
        )
      )
    );
  }

  const root = document.getElementById('auth-root');
  if (root) {
    createRoot(root).render(React.createElement(ForgotPasswordForm));
  }
</script>
